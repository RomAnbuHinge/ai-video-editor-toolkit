models/weights/*.onnx
models/weights/*.pt
models/weights/*.safetensors
models/weights/*.gguf
.cache/
.cache/torch/
.cache/huggingface/

# Rendered output & scratch timelines
renders/
exports/
scratch/
*.mp4
*.mov
*.mkv
*.wav

# Logs & profiling
logs/
*.log
*.prof
*.pstats

# IDE / editors
.idea/
.vscode/
*.swp

# OS cruft
.DS_Store
Thumbs.db

# Local secrets
config/local.toml
config/secrets.env